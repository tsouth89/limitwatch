# Cloudflare Pages response headers.
# The page is a daily-changing dataset, so the HTML + data must always revalidate — otherwise a
# fresh deploy keeps showing a stale copy on refresh (no-cache = "store but revalidate before use",
# i.e. a conditional request that returns 304 when nothing changed, so it stays cheap).

/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/data.json
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
/changes.xml
  Cache-Control: no-cache

# Rarely-changing assets can sit in cache for a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400

# Security headers for everything.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
